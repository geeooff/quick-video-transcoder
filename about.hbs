<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Quick Video Transcoder: third-party notices</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #222; }
    h1 { font-size: 1.4rem; } h2 { font-size: 1.1rem; margin-top: 2.5rem; }
    ul.used { columns: 3; font-size: 0.9rem; }
    pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; font-size: 0.8rem; }
  </style>
</head>
<body>
  <h1>Third-party notices</h1>
  <p>Quick Video Transcoder is built with the open-source libraries below, under the licences that
  follow. FFmpeg is not included: it is a separate program, installed by the user.</p>
  <h2>Licences used</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  {{#each licenses}}
  <h2 id="{{id}}">{{name}}</h2>
  <p>Used by:</p>
  <ul class="used">
    {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
    {{/each}}
  </ul>
  <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
